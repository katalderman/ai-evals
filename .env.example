# Copy to .env and fill in. .env is gitignored - never commit real keys.

# Generator: produces the Version A / Version B answers
OPENAI_API_KEY=sk-...

# Judge: grades the answers. Different model family than the generator,
# which is what prevents self-preference bias.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# OPENAI_MODEL=gpt-4o-mini
# JUDGE_MODEL=claude-opus-5

# Required only if your Anthropic key is org-level rather than workspace-scoped.
# Find it in console.anthropic.com > Settings > Workspaces (id looks like wrkspc_...).
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
